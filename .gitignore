# Superpowers
.superpowers/

# secrets & local credentials — never commit (incident-earned rule: a leaked
# key is a dead key; revoke first, clean history second). IndexNow keys are
# public by protocol design and NOT secrets.
*-secret.json
*.pem
*.key
seo-reports/

# daily ops reports (local automation, never committed)
reports/

# anvil-ops site-local ops data (metrics --import-aio --save CSV archives) — never swept into a submit PR
ops/
