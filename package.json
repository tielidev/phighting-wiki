{
  "name": "phighting-wiki",
  "version": "2.36.1",
  "type": "module",
  "description": "Privacy-safe, content-free Astro framework for building a fast game wiki.",
  "license": "MIT",
  "homepage": "https://phighting-wiki.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/tielidev/phighting-wiki.git"
  },
  "bugs": {
    "url": "https://github.com/tielidev/phighting-wiki/issues"
  },
  "keywords": [
    "astro",
    "cloudflare-pages",
    "game-wiki",
    "wiki-template",
    "seo",
    "i18n",
    "mdx",
    "tailwindcss",
    "static-site",
    "open-source",
    "giscus",
    "lighthouse-100"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "prebuild": "esbuild astro.config.ts --bundle --packages=external --format=esm --platform=node --target=node22 --outfile=.astro-build-config.mjs",
    "dev": "astro dev",
    "build": "astro build --config .astro-build-config.mjs",
    "postbuild": "pagefind --site dist && node scripts/transpile-pagefind.mjs && tsx scripts/write-indexnow-key.ts",
    "preview": "astro preview",
    "check": "astro check",
    "typecheck": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "check-sitemap": "tsx scripts/check-sitemap.ts",
    "check-config": "tsx scripts/check-config.ts",
    "new-post": "tsx scripts/new-post.ts",
    "bulk-new-posts": "tsx scripts/bulk-new-posts.ts",
    "sync-codes": "tsx scripts/sync-codes.ts",
    "gen-covers": "tsx scripts/gen-covers.ts",
    "gen-assets": "tsx scripts/gen-assets.ts",
    "init-indexnow-key": "tsx scripts/init-indexnow-key.ts",
    "submit-indexnow": "tsx scripts/submit-indexnow.ts",
    "check-i18n": "tsx scripts/check-i18n.ts",
    "check-links": "tsx scripts/check-links.ts",
    "check-content": "tsx scripts/check-content.ts",
    "refresh-audit": "tsx scripts/refresh-audit.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/rss": "^4.0.11",
    "@astrojs/sitemap": "^3.2.1",
    "astro": "^7.3.2",
    "astro-icon": "^1.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/tailwind": "^5.1.4",
    "@iconify-json/lucide": "^1.2.123",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/typography": "^0.5.16",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.17.0",
    "eslint-plugin-astro": "^1.3.1",
    "pagefind": "^1.5.2",
    "picomatch": "4.0.5",
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "satori": "^0.33.3",
    "sharp": "^0.35.4",
    "subset-font": "^2.5.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.142.0",
    "yaml": "^2.9.0"
  },
  "private": true
}
