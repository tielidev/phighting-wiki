---
import { Icon } from 'astro-icon/components';
import LocaleLayout from '~/components/layout/LocaleLayout.astro';
import { NAVIGATION_CONFIG } from '~/config/navigation';
import { site } from '~/config/site';
import type { Locale } from '~/i18n/routing';
import { getUi } from '~/i18n/ui';
import { listPath } from '~/lib/url';

interface Props {
  locale: Locale;
  jsonLd?: Record<string, unknown>[];
  alternates?: Array<{ hreflang: string; href: string }>;
}

const { locale, jsonLd = [], alternates = [] } = Astro.props;
const ui = getUi(locale);
---

<LocaleLayout
  locale={locale}
  title={site.name}
  description={site.description}
  alternates={alternates}
  jsonLd={jsonLd}
>
  <main class="section">
    <section class="rounded-3xl border bg-card px-6 py-16 text-center shadow-sm md:px-12 md:py-24">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-nav">Open-source game wiki</p>
      <h1 class="mx-auto mt-4 max-w-4xl text-4xl font-black tracking-tight md:text-6xl">{site.name}</h1>
      <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-muted-foreground">{site.tagline}</p>
      {site.social.official && (
        <a class="btn-primary mt-8 inline-flex" href={site.social.official} target="_blank" rel="noopener noreferrer">
          Visit the official game
          <Icon name="lucide:external-link" class="ml-2 h-4 w-4" />
        </a>
      )}
    </section>

    <section class="mt-12">
      <h2 class="text-2xl font-bold">Browse the wiki</h2>
      <p class="mt-2 text-muted-foreground">Add MDX articles to populate these framework categories.</p>
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {NAVIGATION_CONFIG.map((item) => (
          <a class="card flex items-center gap-3 p-5" href={listPath(item.key, locale)}>
            <Icon name={item.icon} class="h-5 w-5 text-nav" />
            <span class="font-semibold">{ui.nav[item.key as keyof typeof ui.nav] ?? item.key}</span>
          </a>
        ))}
      </div>
    </section>
  </main>
</LocaleLayout>
